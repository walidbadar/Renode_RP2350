//
// Raspberry Pi RP2350 with both of its Arm Cortex-M33 cores.
//
// The peripherals named RP2350_* are not part of Renode: load them first
// with scripts/rp2350.resc, or include the files in peripherals/ yourself.

// ---------------------------------------------------------------------------
// Processors
// ---------------------------------------------------------------------------
//
// Each core has its own NVIC, SysTick and system control block at the same
// address, so those are registered per CPU. Peripheral interrupts go to both
// NVICs and software decides which core enables them; the SIO and GPIO
// interrupts are the exception, with a separate line for each core.

nvic0: IRQControllers.NVIC @ {
        sysbus new Bus.BusPointRegistration { address: 0xE000E000; cpu: cpu0 }
    }
    priorityMask: 0xF0
    systickFrequency: 150000000
    haltSystickOnDeepSleep: false
    IRQ -> cpu0@0

nvic1: IRQControllers.NVIC @ {
        sysbus new Bus.BusPointRegistration { address: 0xE000E000; cpu: cpu1 }
    }
    priorityMask: 0xF0
    systickFrequency: 150000000
    haltSystickOnDeepSleep: false
    IRQ -> cpu1@0

cpu0: CPU.RP2350_CortexM33 @ sysbus
    cpuId: 0
    nvic: nvic0
    sio: sio

cpu1: CPU.RP2350_CortexM33 @ sysbus
    cpuId: 1
    nvic: nvic1
    sio: sio

// ---------------------------------------------------------------------------
// Memory
// ---------------------------------------------------------------------------

// Boot ROM. Load build/bootrom/bootrom.elf here; both cores start in it.
rom: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x8000

// External QSPI flash as seen through the XIP window, 16 MB.
flash: Memory.MappedMemory @ sysbus 0x10000000
    size: 0x1000000

// SRAM0-7 (512 kB) followed by SRAM8-9 (2 x 4 kB).
sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x82000

// RAM reserved for the boot ROM, and the locks the ROM shares between cores.
bootram: Miscellaneous.RP2350_BootRam @ sysbus 0x400E0000

// ---------------------------------------------------------------------------
// Dual-core support
// ---------------------------------------------------------------------------

sio: Miscellaneous.RP2350_SIO @ sysbus 0xD0000000
    gpio: io_bank0
    FifoIRQ0 -> nvic0@25
    FifoIRQ1 -> nvic1@25
    DoorbellIRQ0 -> nvic0@26
    DoorbellIRQ1 -> nvic1@26

psm: Miscellaneous.RP2350_PSM @ sysbus 0x40018000
    core0: cpu0
    core1: cpu1
    nvic1: nvic1

// ---------------------------------------------------------------------------
// Identification
// ---------------------------------------------------------------------------

// An RP2350A, the 60-pin package, at the A2 stepping.
sysinfo: Miscellaneous.RP2350_SysInfo @ sysbus 0x40000000
    revision: 2
    qfn60: true

tbman: Miscellaneous.RP2350_TBMAN @ sysbus 0x40160000

// ---------------------------------------------------------------------------
// Clocks and resets
// ---------------------------------------------------------------------------

resets: Miscellaneous.RP2350_Resets @ sysbus 0x40020000

xosc: Miscellaneous.RP2350_XOSC @ sysbus 0x40048000
    frequency: 12000000

rosc: Miscellaneous.RP2350_ROSC @ sysbus 0x400E8000

pll_sys: Miscellaneous.RP2350_PLL @ sysbus 0x40050000
    reference: xosc

pll_usb: Miscellaneous.RP2350_PLL @ sysbus 0x40058000
    reference: xosc

clocks: Miscellaneous.RP2350_Clocks @ sysbus 0x40010000
    xosc: xosc
    rosc: rosc
    pllSys: pll_sys
    pllUsb: pll_usb

ticks: Miscellaneous.RP2350_Ticks @ sysbus 0x40108000
    clocks: clocks

// ---------------------------------------------------------------------------
// Timers
// ---------------------------------------------------------------------------

timer0: Timers.RP2350_Timer @ sysbus 0x400B0000
    ticks: ticks
    index: 0
    [0-3] -> nvic0@[0-3] | nvic1@[0-3]

timer1: Timers.RP2350_Timer @ sysbus 0x400B8000
    ticks: ticks
    index: 1
    [0-3] -> nvic0@[4-7] | nvic1@[4-7]

watchdog: Timers.RP2350_Watchdog @ sysbus 0x400D8000
    ticks: ticks
    psm: psm

// ---------------------------------------------------------------------------
// GPIO
// ---------------------------------------------------------------------------

pads_bank0: Miscellaneous.RP2350_Pads @ sysbus 0x40038000

io_bank0: GPIOPort.RP2350_IOBank0 @ sysbus 0x40028000
    pads: pads_bank0
    Proc0IRQ -> nvic0@21
    Proc1IRQ -> nvic1@21

// ---------------------------------------------------------------------------
// UART
// ---------------------------------------------------------------------------

// The PL011 that Renode ships, and in front of each the bridge that gives it
// the atomic set, clear and XOR aliases every RP2350 block has.
//
// The FIFOs of the real UARTs are 32 deep. Renode's model has no receive
// timeout interrupt, so with a deep FIFO a short line would sit there until
// enough characters followed it to reach the trigger level. Left at its
// default depth of 1, the model interrupts for every character instead.

uart0: UART.PL011 @ sysbus 0x40070000
    -> nvic0@33 | nvic1@33

uart0_alias: Miscellaneous.RP2350_AtomicAlias @ sysbus 0x40071000
    target: uart0

uart1: UART.PL011 @ sysbus 0x40078000
    -> nvic0@34 | nvic1@34

uart1_alias: Miscellaneous.RP2350_AtomicAlias @ sysbus 0x40079000
    target: uart1

// ---------------------------------------------------------------------------
// Not modelled
// ---------------------------------------------------------------------------
//
// Named so that the log says which block an access went to. Reads return 0
// and writes are dropped.

sysbus:
    init:
        Tag <0x40008000 0x4000> "SYSCFG"
        Tag <0x40030000 0x4000> "IO_QSPI"
        Tag <0x40040000 0x4000> "PADS_QSPI"
        Tag <0x40060000 0x4000> "ACCESSCTRL"
        Tag <0x40068000 0x4000> "BUSCTRL"
        Tag <0x40080000 0x4000> "SPI0"
        Tag <0x40088000 0x4000> "SPI1"
        Tag <0x40090000 0x4000> "I2C0"
        Tag <0x40098000 0x4000> "I2C1"
        Tag <0x400A0000 0x4000> "ADC"
        Tag <0x400A8000 0x4000> "PWM"
        Tag <0x400C0000 0x4000> "HSTX_CTRL"
        Tag <0x400C8000 0x4000> "XIP_CTRL"
        Tag <0x400D0000 0x4000> "XIP_QMI"
        Tag <0x400F0000 0x4000> "TRNG"
        Tag <0x400F8000 0x4000> "SHA256"
        Tag <0x40100000 0x4000> "POWMAN"
        Tag <0x40120000 0x4000> "OTP"
        Tag <0x40130000 0x10000> "OTP_DATA"
        Tag <0x40140000 0x10000> "CORESIGHT"
        Tag <0x40158000 0x4000> "GLITCH_DETECTOR"
        Tag <0x50000000 0x4000> "DMA"
        Tag <0x50100000 0x10000> "USBCTRL_DPRAM"
        Tag <0x50110000 0x4000> "USBCTRL_REGS"
        Tag <0x50200000 0x4000> "PIO0"
        Tag <0x50300000 0x4000> "PIO1"
        Tag <0x50400000 0x4000> "PIO2"
        Tag <0x50500000 0x4000> "XIP_AUX"
        Tag <0x50600000 0x4000> "HSTX_FIFO"
        Tag <0xD0020000 0x1000> "SIO_NONSEC"
        Tag <0xE0080000 0x1000> "EPPB"
