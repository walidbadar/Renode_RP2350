//
// Raspberry Pi Pico 2: an RP2350A with the board's one visible peripheral,
// the green LED on GPIO25. UART0 is on GPIO0 and GPIO1 by default, as on
// the board's pin header.

using "./rp2350.repl"

led: Miscellaneous.LED @ io_bank0 25

io_bank0:
    25 -> led@0
