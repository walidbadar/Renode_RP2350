if BOARD_CORTEX_M33_RP2350A_M33_SMP

# SMP on Cortex-M needs the switch-based context switch.
config USE_SWITCH
	default y

# The Cortex-M default of 320 bytes is too small for the frames that an
# interrupted idle thread holds with SMP.
config IDLE_STACK_SIZE
	default 1024

endif # BOARD_CORTEX_M33_RP2350A_M33_SMP
