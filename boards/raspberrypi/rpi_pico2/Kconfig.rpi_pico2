# The variant is on "m33", the name Zephyr has for the chip with a
# Cortex-M33 in both sockets. The SoC option of that name is deprecated in
# favour of the one for core 0, which is selected here directly.
config BOARD_RPI_PICO2
	select SOC_RP2350A_M33_0 if BOARD_RPI_PICO2_RP2350A_M33_SMP
