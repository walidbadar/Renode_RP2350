:name: Raspberry Pi Pico 2
:description: Runs an image on the Pico 2.

# Set $elf to the image first:
#
#   renode -e '$elf=@build/zephyr/zephyr.elf; include @scripts/rpi_pico2.resc; start'

$name?="rpi_pico2"
$platform?=$ORIGIN/../platforms/rpi_pico2.repl

include $ORIGIN/rp2350.resc

# The image goes in last. Renode would start a Cortex-M from the vector table
# of the last ELF file loaded, but the model starts both cores in the boot ROM.
macro reset
"""
    sysbus LoadELF $bootrom
    sysbus LoadELF $elf
"""
runMacro $reset
