config RP2350_SMP
	bool
	default y
	depends on SOC_SERIES_RP2350 && CPU_CORTEX_M33
	depends on SMP || MP_MAX_NUM_CPUS > 1
	select SOC_PER_CORE_INIT_HOOK
	select SCHED_IPI_SUPPORTED if SMP
	select ARCH_HAS_DIRECTED_IPIS if SMP
